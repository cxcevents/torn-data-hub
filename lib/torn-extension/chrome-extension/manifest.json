{
  "manifest_version": 3,
  "name": "Torn Data Hub",
  "version": "3.1.0",
  "description": "Torn Data Hub overlays for torn.com — Xanax tracker, refills, and effective battle stats. Replaces TornTools features one at a time.",
  "permissions": ["storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["https://api.torn.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.torn.com/index.php*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Torn Data Hub",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
